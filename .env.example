# Database
DATABASE_URL="postgresql://user:password@localhost:5432/tms_magnalog"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here-generate-with-openssl-rand-base64-32"

# Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# App
NEXT_PUBLIC_APP_NAME="MagnaLog TMS"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Cloudflare R2 (canhotos, anexos)
R2_ACCOUNT_ID="your-r2-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key"
R2_SECRET_ACCESS_KEY="your-r2-secret-key"
R2_BUCKET_NAME="magnalog-canhotos"
R2_ENDPOINT="https://<account_id>.r2.cloudflarestorage.com"
# Storage R2 — alerta e limite (defaults para plano gratuito de 10 GB)
R2_STORAGE_LIMIT_GB=10
R2_ALERT_THRESHOLD_GB=1

# Meu Danfe — API v2 (https://meudanfe.com.br, menu API / Integracao)
# Usada para DANFE oficial em PDF, download de XML e sincronizacao.
# Atencao: PUT /fd/add/{chave} custa R$ 0,03 por consulta; o resto e gratis.
DANFE_API_KEY=
