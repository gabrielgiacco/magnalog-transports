generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum UserRole {
  ADMIN
  FINANCEIRO
  OPERACIONAL
  CONFERENTE
  CLIENTE
}

model User {
  id                      String                 @id @default(cuid())
  name                    String?
  email                   String?                @unique
  emailVerified           DateTime?
  image                   String?
  password                String?
  role                    UserRole               @default(OPERACIONAL)
  ativo                   Boolean                @default(true)
  aprovado                Boolean                @default(false)
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt
  accounts                Account[]
  sessions                Session[]
  fornecedoresAutorizados FornecedorAutorizado[]
  qualidadeRegistrada     QualidadeOperacional[] @relation("AdminQualidade")
  avariasRegistradas      Avaria[]               @relation("AvariaRegistrada")
  avariasResolvidas       Avaria[]               @relation("AvariaResolvida")
  auditLogs               AuditLog[]
}

enum TipoEventoAuditoria {
  LOGIN
  LOGOUT
  LOGIN_FAIL
  PORTAL_ACESSO
  PORTAL_BUSCA
  PORTAL_VIEW_ENTREGA
  RASTREIO_PUBLICO
  ENTREGA_CRIADA
  ENTREGA_EDITADA
  ENTREGA_APAGADA
  NF_IMPORTADA
  NF_EDITADA
  NF_APAGADA
  FATURA_CRIADA
  FATURA_EDITADA
  FATURA_APAGADA
  LANCAMENTO_CRIADO
  LANCAMENTO_EDITADO
  LANCAMENTO_APAGADO
  CONTA_PAGAR_CRIADA
  CONTA_PAGAR_PAGA
  CONTA_PAGAR_APAGADA
  OCORRENCIA_CRIADA
  OCORRENCIA_RESOLVIDA
  USUARIO_CRIADO
  USUARIO_EDITADO
  USUARIO_APAGADO
  OUTRO
}

model AuditLog {
  id          String              @id @default(cuid())
  timestamp   DateTime            @default(now())
  tipo        TipoEventoAuditoria
  sucesso     Boolean             @default(true)

  // Snapshot do usuário (mantém histórico mesmo se usuário for apagado)
  userId      String?
  userEmail   String?
  userRole    String?
  userName    String?

  // Recurso afetado
  recursoTipo String?  // 'entrega', 'nf', 'fatura', 'lancamento', etc.
  recursoId   String?
  recursoDesc String?  // descrição legível (ex: "ENT-00042", "Fatura FAT-00012")

  // Metadados da requisição
  ip          String?
  userAgent   String?  @db.Text
  metodo      String?  // GET, POST, PATCH, DELETE
  rota        String?  // /api/entregas/123

  // Dados livres
  detalhes    String?  @db.Text  // JSON com info extra (termo pesquisado, antes/depois etc.)

  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([timestamp(sort: Desc)])
  @@index([userId])
  @@index([tipo])
  @@index([ip])
  @@index([recursoTipo, recursoId])
}

model FornecedorAutorizado {
  id           String @id @default(cuid())
  userId       String
  cnpjEmitente String
  user         User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, cnpjEmitente])
}

enum TipoMotorista {
  FROTA
  TERCEIRO
  DIARIA
}

enum TipoVeiculo {
  VUC
  TRES_QUARTOS
  TOCO
  TRUCK
  CARRETA
  BITRUCK
  UTILITARIO
}

model Veiculo {
  id            String      @id @default(cuid())
  placa         String      @unique
  tipo          TipoVeiculo
  modelo        String?
  ano           Int?
  capacidadeKg  Float?
  ativo         Boolean     @default(true)
  motoristaId   String? // Vinculo de motorista padrão (quem dirige por default)
  donoId        String? // Dono do veículo (pessoa que recebe o acerto financeiro)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  motorista     Motorista?  @relation("VeiculoMotoristaPadrao", fields: [motoristaId], references: [id])
  dono          Motorista?  @relation("VeiculoDono", fields: [donoId], references: [id])
  entregas      Entrega[]   @relation("VeiculoPrincipal")
  entregasCompl Entrega[]   @relation("VeiculoComplementar")
  rotas         Rota[]

  @@index([donoId])
}

model Motorista {
  id            String        @id @default(cuid())
  nome          String
  cpf           String?       @unique
  cnh           String?
  categoriaCnh  String?
  telefone      String?
  pix           String?
  ativo         Boolean       @default(true)
  tipo          TipoMotorista @default(TERCEIRO)
  valorDiaria   Float? // Usado se tipo == DIARIA
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  veiculos          Veiculo[] @relation("VeiculoMotoristaPadrao")
  veiculosComoDono  Veiculo[] @relation("VeiculoDono")
  entregas      Entrega[]     @relation("MotoristaPrincipal")
  entregasCompl Entrega[]     @relation("MotoristaComplementar")
  rotas         Rota[]
  avarias       Avaria[]
}

model Cliente {
  id          String    @id @default(cuid())
  cnpj        String    @unique
  razaoSocial String
  fantasia    String?
  email       String?
  telefone    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  entregas    Entrega[]
}

enum StatusRota {
  PLANEJADA
  EM_ANDAMENTO
  CONCLUIDA
  CANCELADA
}

model Rota {
  id                    String                 @id @default(cuid())
  codigo                String                 @unique
  data                  DateTime
  motoristaId           String?
  veiculoId             String?
  pesoTotal             Float                  @default(0)
  volumeTotal           Int                    @default(0)
  valorMotorista        Float                  @default(0)
  valorSaida            Float                  @default(0)
  valorDescarga         Float                  @default(0)
  adiantamentoMotorista Float                  @default(0)
  dataAdiantamento      DateTime?
  descontosMotorista    Float                  @default(0)
  saldoMotorista        Float                  @default(0)
  dataPagamentoSaldo    DateTime?
  statusCanhoto         String                 @default("PENDENTE")
  status                StatusRota             @default(PLANEJADA)
  observacoes           String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  motorista             Motorista?             @relation(fields: [motoristaId], references: [id])
  veiculo               Veiculo?               @relation(fields: [veiculoId], references: [id])
  entregas              Entrega[]
  contasPagar           ContaPagar[]
  qualidade             QualidadeOperacional?
  avarias               Avaria[]
  lancamentos           LancamentoFinanceiro[]
}

enum StatusEntrega {
  PROGRAMADO
  EM_SEPARACAO
  CARREGADO
  EM_ROTA
  ENTREGUE
  FINALIZADO
  OCORRENCIA
}

model Entrega {
  id                String        @id @default(cuid())
  codigo            String
  clienteId         String?
  cnpj              String
  razaoSocial       String
  cidade            String
  uf                String?
  endereco          String?
  bairro            String?
  cep               String?
  latitude          Float?
  longitude         Float?
  dataChegada       DateTime?
  dataAgendada      DateTime?
  dataEntrega       DateTime?
  motoristaId       String?
  veiculoId         String?
  motoristaComplId  String?
  veiculoComplId    String?
  rotaId            String?
  chaveAcesso       String?       @db.Text
  pesoTotal         Float         @default(0)
  volumeTotal       Int           @default(0)
  status            StatusEntrega @default(PROGRAMADO)
  observacoes       String?
  // Receitas (Faturamento)
  valorFrete        Float         @default(0)
  valorDescarga     Float         @default(0)
  valorArmazenagem  Float         @default(0)
  diasArmazenagem   Int           @default(0)
  quantidadePaletes Int           @default(0)

  // Custos e Acerto do Motorista Terceiro (Novo Controle Financeiro)
  valorMotorista        Float     @default(0) // Valor combinado para a viagem
  valorSaida            Float     @default(0) // Pedágios, Vales de Saída
  adiantamentoMotorista Float     @default(0) // $ Adiantado
  dataAdiantamento      DateTime? // Data do adiantamento
  descontosMotorista    Float     @default(0) // Avarias, faltas, etc.
  saldoMotorista        Float     @default(0) // (Combinado - Saida - Adiantamento - Descontos)
  dataPagamentoSaldo    DateTime? // Quitação do Terceiro
  statusCanhoto         String    @default("PENDENTE") // PENDENTE ou RECEBIDO

  // Custo e Acerto do Motorista Complementar
  valorMotoristaCompl        Float     @default(0)
  valorSaidaCompl            Float     @default(0)
  adiantamentoMotoristaCompl Float     @default(0)
  descontosMotoristaCompl    Float     @default(0)
  saldoMotoristaCompl        Float     @default(0)
  dataAdiantamentoCompl      DateTime?
  dataPagamentoSaldoCompl    DateTime?
  statusCanhotoCompl         String    @default("PENDENTE")

  // Legado (se ainda em uso)
  adiantamento   Float                  @default(0)
  dataPagamento  DateTime?
  saldoPendente  Float                  @default(0)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  cliente        Cliente?               @relation(fields: [clienteId], references: [id])
  motorista      Motorista?             @relation("MotoristaPrincipal", fields: [motoristaId], references: [id])
  veiculo        Veiculo?               @relation("VeiculoPrincipal", fields: [veiculoId], references: [id])
  motoristaCompl Motorista?             @relation("MotoristaComplementar", fields: [motoristaComplId], references: [id])
  veiculoCompl   Veiculo?               @relation("VeiculoComplementar", fields: [veiculoComplId], references: [id])
  rota           Rota?                  @relation(fields: [rotaId], references: [id])
  faturaId       String?
  fatura         Fatura?                @relation(fields: [faturaId], references: [id])
  notas          NotaFiscal[]
  ocorrencias    Ocorrencia[]
  contasPagar    ContaPagar[]
  qualidade      QualidadeOperacional?
  avarias        Avaria[]
  lancamentos    LancamentoFinanceiro[]
  notasServico   NotaServico[]
  diarias        Diaria[]

  @@index([cnpj])
  @@index([status])
  @@index([rotaId])
  @@index([faturaId])
  @@index([dataAgendada])
}

model NotaFiscal {
  id                String    @id @default(cuid())
  chaveAcesso       String    @unique
  numero            String
  serie             String?
  emitenteCnpj      String
  emitenteRazao     String
  destinatarioCnpj  String
  destinatarioRazao String
  cidade            String?
  uf                String?
  endereco          String?
  bairro            String?
  cep               String?
  latitude          Float?
  longitude         Float?
  volumes           Int       @default(0)
  pesoBruto         Float     @default(0)
  valorNota         Float     @default(0)
  dataEmissao       DateTime?
  entregaId         String?
  xmlOriginal       String?   @db.Text
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  entrega           Entrega?  @relation(fields: [entregaId], references: [id], onDelete: Cascade)
  cteId             String?
  cte               CTe?      @relation(fields: [cteId], references: [id])
  avarias           Avaria[]
  notasServico      NotaServico[]

  @@index([emitenteCnpj])
  @@index([destinatarioCnpj])
  @@index([entregaId])
  @@index([cteId])
}

model Ocorrencia {
  id        String   @id @default(cuid())
  entregaId String
  tipo      String
  descricao String
  resolucao String?
  resolvida Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  entrega   Entrega  @relation(fields: [entregaId], references: [id], onDelete: Cascade)
}

model CTe {
  id            String       @id @default(cuid())
  chaveAcesso   String       @unique
  numero        String
  serie         String?
  dataEmissao   DateTime?
  valorReceber  Float        @default(0)
  valorPedagio  Float        @default(0)
  valorImpostos Float        @default(0)
  emitenteCnpj  String
  emitenteNome  String?
  tomadorCnpj   String
  tomadorNome   String?
  notas         NotaFiscal[]
  faturaId      String?
  fatura        Fatura?      @relation(fields: [faturaId], references: [id])
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([tomadorCnpj])
  @@index([faturaId])
}

enum StatusFatura {
  ABERTA
  PAGA
  CANCELADA
}

model Fatura {
  id              String                 @id @default(cuid())
  numero          String                 @unique
  clienteCnpj     String
  clienteNome     String
  valorFretes     Float                  @default(0)
  valorReembolsos Float                  @default(0)
  valorTotal      Float                  @default(0)
  dataEmissao     DateTime               @default(now())
  dataVencimento  DateTime
  status          StatusFatura           @default(ABERTA)
  observacoes     String?                @db.Text
  ctes            CTe[]
  entregas        Entrega[]
  lancamentos     LancamentoFinanceiro[]
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  @@index([clienteCnpj])
}

enum TipoContaPagar {
  MOTORISTA
  DESCARGA
  ABASTECIMENTO
  PEDAGIO
  OUTROS
}

enum StatusContaPagar {
  PENDENTE
  PAGO
  CANCELADO
}

model ContaPagar {
  id             String           @id @default(cuid())
  tipo           TipoContaPagar
  descricao      String
  valor          Float
  dataVencimento DateTime
  dataPagamento  DateTime?
  status         StatusContaPagar @default(PENDENTE)
  favorecido     String? // Quem vai receber (Motorista, Chapa de Descarga)
  formaPagamento FormaPagamento?
  observacoes    String?          @db.Text
  rotaId         String?
  entregaId      String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  rota        Rota?                  @relation(fields: [rotaId], references: [id], onDelete: Cascade)
  entrega     Entrega?               @relation(fields: [entregaId], references: [id], onDelete: Cascade)
  lancamentos LancamentoFinanceiro[]

  @@index([rotaId])
  @@index([entregaId])
  @@index([status])
  @@index([dataVencimento])
}

model TabelaArmazenagem {
  id             String   @id @default(cuid())
  cnpjCliente    String   @unique
  nomeCliente    String
  diasFree       Int      @default(0)
  valorPaleteDia Float    @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model FaturaArmazenagem {
  id             String                  @id @default(cuid())
  numero         String                  @unique
  fornecedorCnpj String
  fornecedorNome String
  valorTotal     Float                   @default(0)
  dataEmissao    DateTime                @default(now())
  dataVencimento DateTime
  status         StatusFatura            @default(ABERTA)
  observacoes    String?                 @db.Text
  items          ItemFaturaArmazenagem[]
  lancamentos    LancamentoFinanceiro[]
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  @@index([fornecedorCnpj])
}

model ItemFaturaArmazenagem {
  id                String            @id @default(cuid())
  faturaId          String
  fatura            FaturaArmazenagem @relation(fields: [faturaId], references: [id], onDelete: Cascade)
  entregaId         String
  fornecedorCnpj    String
  codigoEntrega     String
  destinatarioRazao String?
  cidade            String?
  nfs               String?
  paletes           Int               @default(0)
  diasDecorridos    Int               @default(0)
  diasCobraveis     Int               @default(0)
  diasFree          Int               @default(0)
  valorPaleteDia    Float             @default(0)
  valorCalculado    Float             @default(0)
  dataEntrada       DateTime?
  dataSaida         DateTime?
  createdAt         DateTime          @default(now())

  @@unique([entregaId, fornecedorCnpj])
  @@index([faturaId])
  @@index([fornecedorCnpj])
}

model QualidadeOperacional {
  id                  String   @id @default(cuid())
  entregaId           String?  @unique
  rotaId              String?  @unique
  conferenciaCorreta  Boolean  @default(true)
  carregamentoCorreto Boolean  @default(true)
  houveAvaria         Boolean  @default(false)
  organizacaoGeral    Boolean  @default(true)
  observacoes         String?  @db.Text
  pontuacao           Int      @default(40)
  adminId             String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  entrega Entrega? @relation(fields: [entregaId], references: [id], onDelete: Cascade)
  rota    Rota?    @relation(fields: [rotaId], references: [id], onDelete: Cascade)
  admin   User     @relation("AdminQualidade", fields: [adminId], references: [id])

  @@index([entregaId])
  @@index([rotaId])
  @@index([adminId])
}

// ─── Avarias / Devoluções ────────────────────────────────────────────────

enum TipoAvaria {
  AVARIA
  FALTA
  INVERSAO
  SOBRA
  DEVOLUCAO
  SEM_PEDIDO
}

enum FaseAvaria {
  CONFERENCIA
  CARREGAMENTO
  EM_ROTA
  ENTREGA
  DEVOLUCAO
}

enum StatusAvaria {
  PENDENTE
  EM_ANALISE
  RESOLVIDA
  DESCARTADA
}

enum StatusDevolucao {
  PENDENTE
  DEVOLVIDO_CLIENTE
  RETIRADO
  DESCARTADO
}

model Avaria {
  id     String       @id @default(cuid())
  codigo String       @unique
  tipo   TipoAvaria
  fase   FaseAvaria
  status StatusAvaria @default(PENDENTE)

  entregaId    String?
  notaFiscalId String?
  motoristaId  String?
  rotaId       String?

  descricao     String  @db.Text
  observacoes   String? @db.Text
  valorPrejuizo Float   @default(0)

  registradoPorId String
  dataOcorrencia  DateTime
  localOcorrencia String?

  dataChegada           DateTime?
  transportadoraChegada String?
  motoristaChegada      String?
  placaChegada          String?

  resolucao      String?   @db.Text
  resolvidoPorId String?
  dataResolucao  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entrega       Entrega?    @relation(fields: [entregaId], references: [id])
  notaFiscal    NotaFiscal? @relation(fields: [notaFiscalId], references: [id])
  motorista     Motorista?  @relation(fields: [motoristaId], references: [id])
  rota          Rota?       @relation(fields: [rotaId], references: [id])
  registradoPor User        @relation("AvariaRegistrada", fields: [registradoPorId], references: [id])
  resolvidoPor  User?       @relation("AvariaResolvida", fields: [resolvidoPorId], references: [id])

  produtos   AvariaProduto[]
  devolucoes NotaDevolucao[]

  @@index([entregaId])
  @@index([notaFiscalId])
  @@index([motoristaId])
  @@index([status])
  @@index([tipo])
  @@index([dataOcorrencia])
}

model AvariaProduto {
  id               String   @id @default(cuid())
  avariaId         String
  codigoProduto    String
  descricao        String
  ncm              String?
  unidade          String?
  quantidadeNF     Float
  quantidadeAvaria Float
  valorUnitario    Float    @default(0)
  valorTotal       Float    @default(0)
  observacoes      String?  @db.Text
  createdAt        DateTime @default(now())

  avaria Avaria @relation(fields: [avariaId], references: [id], onDelete: Cascade)

  @@index([avariaId])
}

// ─── Controle de Paletes CHEP ────────────────────────────────────────────

enum TipoMovimentoPalete {
  SAIDA
  ENTRADA
}

enum StatusPalete {
  PENDENTE
  ACEITO
  CANCELADO
  RETORNOU
}

model PaleteConfig {
  id         String   @id @default("default")
  cnpjPool   String   @default("")
  razaoPool  String   @default("")
  glnPool    String   @default("")
  tipoPallet String   @default("CHEP")
  updatedAt  DateTime @updatedAt
}

model PaleteMovimento {
  id             String              @id @default(cuid())
  nf             String
  tipoPallet     String              @default("CHEP")
  dataEmissao    DateTime
  quantidade     Int
  cnpjCliente    String
  razaoCliente   String
  glnCliente     String?
  tipoMovimento  TipoMovimentoPalete
  status         StatusPalete        @default(PENDENTE)
  observacoes    String?
  ticketBaixa    String?
  chaveAcessoNFe String?             @unique
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([dataEmissao])
  @@index([status])
  @@index([tipoMovimento])
  @@index([cnpjCliente])
}

model NotaDevolucao {
  id                String    @id @default(cuid())
  avariaId          String
  chaveAcesso       String    @unique
  numero            String
  serie             String?
  emitenteCnpj      String
  emitenteRazao     String
  destinatarioCnpj  String
  destinatarioRazao String
  dataEmissao       DateTime?
  valorNota         Float     @default(0)
  xmlOriginal       String?   @db.Text

  status       StatusDevolucao @default(PENDENTE)
  dataRetorno  DateTime?
  dataRetirada DateTime?
  dataDescarte DateTime?
  responsavel  String?
  observacoes  String?         @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  avaria Avaria @relation(fields: [avariaId], references: [id], onDelete: Cascade)

  @@index([avariaId])
  @@index([status])
}

// ─── ERP Financeiro ──────────────────────────────────────────────────────

enum TipoLancamento {
  RECEITA
  DESPESA
}

enum StatusLancamento {
  PENDENTE
  PAGO
  CANCELADO
}

enum FormaPagamento {
  DINHEIRO
  PIX
  TRANSFERENCIA
  BOLETO
  CARTAO_CREDITO
  CARTAO_DEBITO
  CHEQUE
  OUTRO
}

enum OrigemLancamento {
  MANUAL
  FATURA
  FATURA_ARMAZENAGEM
  ACERTO_MOTORISTA
  CONTA_PAGAR
  NOTA_SERVICO
  DIARIA
}

enum StatusDiaria {
  PENDENTE
  PAGA
  CANCELADA
}

model Diaria {
  id             String       @id @default(cuid())
  numero         String       @unique
  entregaId      String
  entrega        Entrega      @relation(fields: [entregaId], references: [id], onDelete: Cascade)

  clienteCnpj    String
  clienteNome    String

  motivo         String?
  valor          Float        @default(0)
  status         StatusDiaria @default(PENDENTE)

  dataOcorrencia DateTime     @default(now())
  dataPagamento  DateTime?
  formaPagamento FormaPagamento?
  observacoes    String?      @db.Text

  lancamentos    LancamentoFinanceiro[]

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([entregaId])
  @@index([clienteCnpj])
  @@index([status])
}

model NotaServico {
  id                 String   @id @default(cuid())
  numero             String
  codigoVerificacao  String?
  dataEmissao        DateTime
  valorServicos      Float    @default(0)
  valorIss           Float    @default(0)
  aliquota           Float    @default(0)

  prestadorCnpj      String
  prestadorRazao     String?
  tomadorCnpj        String
  tomadorRazao       String?
  tomadorMunicipio   String?
  tomadorUf          String?

  discriminacao      String?  @db.Text
  informacoesAdicionais String? @db.Text

  entregaId          String?
  entrega            Entrega? @relation(fields: [entregaId], references: [id], onDelete: SetNull)
  notaFiscalId       String?
  notaFiscal         NotaFiscal? @relation(fields: [notaFiscalId], references: [id], onDelete: SetNull)

  lancamentos        LancamentoFinanceiro[]

  xmlOriginal        String?  @db.Text
  arquivoNome        String?

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([prestadorCnpj, numero])
  @@index([tomadorCnpj])
  @@index([entregaId])
  @@index([notaFiscalId])
  @@index([dataEmissao])
}

model CategoriaFinanceira {
  id            String                   @id @default(cuid())
  nome          String
  tipo          TipoLancamento
  ativo         Boolean                  @default(true)
  ordem         Int                      @default(0)
  sistema       Boolean                  @default(false) // categoria padrão (não pode apagar, só desativar)
  subcategorias SubcategoriaFinanceira[]
  lancamentos   LancamentoFinanceiro[]
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt

  @@unique([nome, tipo])
  @@index([tipo, ativo])
}

model SubcategoriaFinanceira {
  id          String                 @id @default(cuid())
  nome        String
  ativo       Boolean                @default(true)
  categoriaId String
  categoria   CategoriaFinanceira    @relation(fields: [categoriaId], references: [id], onDelete: Cascade)
  lancamentos LancamentoFinanceiro[]
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  @@unique([categoriaId, nome])
  @@index([categoriaId])
}

model LancamentoFinanceiro {
  id             String           @id @default(cuid())
  descricao      String
  tipo           TipoLancamento
  valor          Float
  dataVencimento DateTime
  dataPagamento  DateTime?
  status         StatusLancamento @default(PENDENTE)
  origem         OrigemLancamento @default(MANUAL)

  formaPagamento FormaPagamento?
  contaBancaria  String?

  categoriaId    String?
  subcategoriaId String?
  categoria      CategoriaFinanceira?    @relation(fields: [categoriaId], references: [id], onDelete: SetNull)
  subcategoria   SubcategoriaFinanceira? @relation(fields: [subcategoriaId], references: [id], onDelete: SetNull)

  favorecido  String?
  anexoUrl    String?
  observacoes String? @db.Text

  rotaId              String?
  entregaId           String?
  faturaId            String?
  faturaArmazenagemId String?
  contaPagarId        String?
  notaServicoId       String?
  diariaId            String?

  rota              Rota?              @relation(fields: [rotaId], references: [id], onDelete: SetNull)
  entrega           Entrega?           @relation(fields: [entregaId], references: [id], onDelete: SetNull)
  fatura            Fatura?            @relation(fields: [faturaId], references: [id], onDelete: SetNull)
  faturaArmazenagem FaturaArmazenagem? @relation(fields: [faturaArmazenagemId], references: [id], onDelete: SetNull)
  contaPagar        ContaPagar?        @relation(fields: [contaPagarId], references: [id], onDelete: SetNull)
  notaServico       NotaServico?       @relation(fields: [notaServicoId], references: [id], onDelete: SetNull)
  diaria            Diaria?            @relation(fields: [diariaId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoriaId])
  @@index([subcategoriaId])
  @@index([rotaId])
  @@index([entregaId])
  @@index([faturaId])
  @@index([faturaArmazenagemId])
  @@index([contaPagarId])
  @@index([notaServicoId])
  @@index([diariaId])
  @@index([status, dataPagamento])
  @@index([tipo, dataPagamento])
}

model NormaPaletizacao {
  id                     String   @id @default(cuid())
  clienteCnpj            String // CNPJ do Cliente (Destinatário que recebe a mercadoria)
  fornecedorCnpj         String // CNPJ do Fornecedor (Emitente da NF)
  codigoProduto          String // Código do produto (CODPROD) do XML da NF
  descricao              String? // Descrição do produto para conferência
  embalagem              String? // Ex: "8X1"
  lastro                 Int // Quantidade de caixas na camada (lastro)
  altura                 Int // Quantidade de camadas de altura
  quantidadeCaixasPalete Int // Quantidade de caixas total por palete (lastro * altura)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@unique([clienteCnpj, fornecedorCnpj, codigoProduto])
  @@index([clienteCnpj])
  @@index([fornecedorCnpj])
}
