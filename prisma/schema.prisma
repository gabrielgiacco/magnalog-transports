generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum UserRole {
  ADMIN
  FINANCEIRO
  OPERACIONAL
  CONFERENTE
  CLIENTE
}

model User {
  id                      String                 @id @default(cuid())
  name                    String?
  email                   String?                @unique
  emailVerified           DateTime?
  image                   String?
  password                String?
  role                    UserRole               @default(OPERACIONAL)
  ativo                   Boolean                @default(true)
  aprovado                Boolean                @default(false)
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt
  accounts                Account[]
  sessions                Session[]
  fornecedoresAutorizados FornecedorAutorizado[]
  qualidadeRegistrada     QualidadeOperacional[] @relation("AdminQualidade")
  avariasRegistradas      Avaria[]               @relation("AvariaRegistrada")
  avariasResolvidas       Avaria[]               @relation("AvariaResolvida")
  auditLogs               AuditLog[]
  anexosEnviados          AnexoEntrega[]
  anexosGenericos         Anexo[]                @relation("AnexoUploader")
  anexosLiberados         Anexo[]                @relation("AnexoLiberador")
  declaracoesSaida        DeclaracaoSaida[]      @relation("DeclaracaoSaidaEmitida")
  orcamentos              Orcamento[]            @relation("OrcamentoCriado")
  notasCanceladas         NotaFiscal[]           @relation("NotaCancelada")
  solicitacoesTicket      SolicitacaoTicket[]    @relation("TicketCriadoPor")
  mensagensWhats          MensagemWhats[]        @relation("MensagemWhatsEnviadaPor")
}

enum TipoEventoAuditoria {
  LOGIN
  LOGOUT
  LOGIN_FAIL
  PORTAL_ACESSO
  PORTAL_BUSCA
  PORTAL_VIEW_ENTREGA
  RASTREIO_PUBLICO
  ENTREGA_CRIADA
  ENTREGA_EDITADA
  ENTREGA_APAGADA
  NF_IMPORTADA
  NF_EDITADA
  NF_APAGADA
  FATURA_CRIADA
  FATURA_EDITADA
  FATURA_APAGADA
  LANCAMENTO_CRIADO
  LANCAMENTO_EDITADO
  LANCAMENTO_APAGADO
  CONTA_PAGAR_CRIADA
  CONTA_PAGAR_PAGA
  CONTA_PAGAR_APAGADA
  OCORRENCIA_CRIADA
  OCORRENCIA_RESOLVIDA
  ANEXO_LIBERADO_PORTAL
  ANEXO_OCULTADO_PORTAL
  USUARIO_CRIADO
  USUARIO_EDITADO
  USUARIO_APAGADO
  WHATSAPP_ENVIADO
  OUTRO
}

model AuditLog {
  id          String              @id @default(cuid())
  timestamp   DateTime            @default(now())
  tipo        TipoEventoAuditoria
  sucesso     Boolean             @default(true)

  // Snapshot do usuário (mantém histórico mesmo se usuário for apagado)
  userId      String?
  userEmail   String?
  userRole    String?
  userName    String?

  // Recurso afetado
  recursoTipo String?  // 'entrega', 'nf', 'fatura', 'lancamento', etc.
  recursoId   String?
  recursoDesc String?  // descrição legível (ex: "ENT-00042", "Fatura FAT-00012")

  // Metadados da requisição
  ip          String?
  userAgent   String?  @db.Text
  metodo      String?  // GET, POST, PATCH, DELETE
  rota        String?  // /api/entregas/123

  // Dados livres
  detalhes    String?  @db.Text  // JSON com info extra (termo pesquisado, antes/depois etc.)

  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([timestamp(sort: Desc)])
  @@index([userId])
  @@index([tipo])
  @@index([ip])
  @@index([recursoTipo, recursoId])
}

model FornecedorAutorizado {
  id           String @id @default(cuid())
  userId       String
  cnpjEmitente String
  user         User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, cnpjEmitente])
}

enum TipoMotorista {
  FROTA
  TERCEIRO
  DIARIA
}

enum TipoVeiculo {
  VUC
  TRES_QUARTOS
  TOCO
  TRUCK
  CARRETA
  BITRUCK
  UTILITARIO
}

model Veiculo {
  id                String      @id @default(cuid())
  placa             String      @unique
  tipo              TipoVeiculo
  modelo            String?
  ano               Int?
  capacidadeKg      Float?
  capacidadePaletes Int?
  capacidadeM3      Float?
  ativo             Boolean     @default(true)
  motoristaId       String? // Vinculo de motorista padrão (quem dirige por default)
  donoId            String? // Dono do veículo (pessoa que recebe o acerto financeiro)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  motorista     Motorista?  @relation("VeiculoMotoristaPadrao", fields: [motoristaId], references: [id])
  dono          Motorista?  @relation("VeiculoDono", fields: [donoId], references: [id])
  entregas      Entrega[]   @relation("VeiculoPrincipal")
  entregasCompl Entrega[]   @relation("VeiculoComplementar")
  rotas         Rota[]

  @@index([donoId])
}

model Motorista {
  id            String        @id @default(cuid())
  nome          String
  cpf           String?       @unique
  cnh           String?
  categoriaCnh  String?
  telefone      String?
  pix           String?
  ativo         Boolean       @default(true)
  tipo          TipoMotorista @default(TERCEIRO)
  valorDiaria   Float? // Usado se tipo == DIARIA
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  veiculos          Veiculo[] @relation("VeiculoMotoristaPadrao")
  veiculosComoDono  Veiculo[] @relation("VeiculoDono")
  entregas      Entrega[]     @relation("MotoristaPrincipal")
  entregasCompl Entrega[]     @relation("MotoristaComplementar")
  rotas         Rota[]
  avarias       Avaria[]
}

model Cliente {
  id          String    @id @default(cuid())
  cnpj        String    @unique
  razaoSocial String
  fantasia    String?
  email       String?
  telefone    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  entregas    Entrega[]
}

enum StatusRota {
  PLANEJADA
  EM_ANDAMENTO
  CONCLUIDA
  CANCELADA
}

model Rota {
  id                    String                 @id @default(cuid())
  codigo                String                 @unique
  data                  DateTime
  motoristaId           String?
  veiculoId             String?
  pesoTotal             Float                  @default(0)
  volumeTotal           Int                    @default(0)
  valorMotorista        Float                  @default(0)
  valorSaida            Float                  @default(0)
  valorDescarga         Float                  @default(0)
  adiantamentoMotorista Float                  @default(0)
  dataAdiantamento      DateTime?
  descontosMotorista    Float                  @default(0)
  saldoMotorista        Float                  @default(0)
  dataPagamentoSaldo    DateTime?
  statusCanhoto         String                 @default("PENDENTE")
  status                StatusRota             @default(PLANEJADA)
  observacoes           String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  motorista             Motorista?             @relation(fields: [motoristaId], references: [id])
  veiculo               Veiculo?               @relation(fields: [veiculoId], references: [id])
  entregas              Entrega[]
  contasPagar           ContaPagar[]
  qualidade             QualidadeOperacional?
  avarias               Avaria[]
  lancamentos           LancamentoFinanceiro[]
  mdfes                 Mdfe[]
}

enum StatusEntrega {
  PROGRAMADO
  EM_SEPARACAO
  CARREGADO
  EM_ROTA
  ENTREGUE
  FINALIZADO
  OCORRENCIA
}

model Entrega {
  id                String        @id @default(cuid())
  codigo            String
  clienteId         String?
  cnpj              String
  razaoSocial       String
  cidade            String
  uf                String?
  endereco          String?
  bairro            String?
  cep               String?
  latitude          Float?
  longitude         Float?
  dataChegada       DateTime?
  dataAgendada      DateTime?
  dataEntrega       DateTime?
  motoristaId       String?
  veiculoId         String?
  motoristaComplId  String?
  veiculoComplId    String?
  rotaId            String?
  chaveAcesso       String?       @db.Text
  pesoTotal         Float         @default(0)
  volumeTotal       Int           @default(0)
  status            StatusEntrega @default(PROGRAMADO)
  observacoes       String?
  // Receitas (Faturamento)
  valorFrete        Float         @default(0)
  valorDescarga     Float         @default(0)
  valorArmazenagem  Float         @default(0)
  diasArmazenagem   Int           @default(0)
  quantidadePaletes Int           @default(0)

  // Custos e Acerto do Motorista Terceiro (Novo Controle Financeiro)
  valorMotorista        Float     @default(0) // Valor combinado para a viagem
  valorSaida            Float     @default(0) // Pedágios, Vales de Saída
  adiantamentoMotorista Float     @default(0) // $ Adiantado
  dataAdiantamento      DateTime? // Data do adiantamento
  descontosMotorista    Float     @default(0) // Avarias, faltas, etc.
  saldoMotorista        Float     @default(0) // (Combinado - Saida - Adiantamento - Descontos)
  dataPagamentoSaldo    DateTime? // Quitação do Terceiro
  statusCanhoto         String    @default("PENDENTE") // PENDENTE ou RECEBIDO

  // Custo e Acerto do Motorista Complementar
  valorMotoristaCompl        Float     @default(0)
  valorSaidaCompl            Float     @default(0)
  adiantamentoMotoristaCompl Float     @default(0)
  descontosMotoristaCompl    Float     @default(0)
  saldoMotoristaCompl        Float     @default(0)
  dataAdiantamentoCompl      DateTime?
  dataPagamentoSaldoCompl    DateTime?
  statusCanhotoCompl         String    @default("PENDENTE")

  // Devolução para a fábrica (retorno de mercadoria após ocorrência)
  dataDevolucaoFabrica     DateTime?
  transportadoraDevolucao  String?
  motoristaDevolucao       String?
  placaDevolucao           String?

  // Legado (se ainda em uso)
  adiantamento   Float                  @default(0)
  dataPagamento  DateTime?
  saldoPendente  Float                  @default(0)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  cliente        Cliente?               @relation(fields: [clienteId], references: [id])
  motorista      Motorista?             @relation("MotoristaPrincipal", fields: [motoristaId], references: [id])
  veiculo        Veiculo?               @relation("VeiculoPrincipal", fields: [veiculoId], references: [id])
  motoristaCompl Motorista?             @relation("MotoristaComplementar", fields: [motoristaComplId], references: [id])
  veiculoCompl   Veiculo?               @relation("VeiculoComplementar", fields: [veiculoComplId], references: [id])
  rota           Rota?                  @relation(fields: [rotaId], references: [id])
  faturaId       String?
  fatura         Fatura?                @relation(fields: [faturaId], references: [id])
  notas          NotaFiscal[]
  ocorrencias    Ocorrencia[]
  contasPagar    ContaPagar[]
  qualidade      QualidadeOperacional?
  avarias        Avaria[]
  lancamentos    LancamentoFinanceiro[]
  notasServico   NotaServico[]
  diarias        Diaria[]
  anexos         AnexoEntrega[]
  solicitacoesTicket SolicitacaoTicket[]
  mensagensWhats     MensagemWhats[]

  // Token para upload público via link (motorista sobe canhoto pelo celular)
  uploadToken       String?   @unique
  uploadTokenExpira DateTime?

  @@index([cnpj])
  @@index([status])
  @@index([rotaId])
  @@index([faturaId])
  @@index([dataAgendada])
}

enum TipoAnexo {
  CANHOTO
  FOTO
  DOCUMENTO
  CNH
  CRLV
  ANTT
  SEGURO
  CONTRATO
  DESCARGA
  CANHOTO_DESCARGA
  DECLARACAO
  OUTRO
}

// Modelo genérico polimórfico para anexos de Motorista/Veículo/Avaria.
// A relação com Entrega continua no AnexoEntrega (mantido por compat + statusCanhoto).
model Anexo {
  id             String    @id @default(cuid())
  ownerType      String    // "MOTORISTA" | "VEICULO" | "AVARIA"
  ownerId        String
  tipo           TipoAnexo @default(OUTRO)
  objectKey      String
  filename       String
  mimeType       String
  size           Int       @default(0)
  descricao      String?
  uploadadoPorId String?
  uploadadoPor   User?     @relation("AnexoUploader", fields: [uploadadoPorId], references: [id])
  createdAt      DateTime  @default(now())

  // Liberação para o portal do cliente (só se aplica a ownerType = "AVARIA").
  // Nasce sempre privado; liberar é ação manual e auditada.
  visivelPortal Boolean   @default(false)
  liberadoPorId String?
  liberadoPor   User?     @relation("AnexoLiberador", fields: [liberadoPorId], references: [id])
  liberadoEm    DateTime?

  @@index([ownerType, ownerId])
  @@index([ownerType, ownerId, visivelPortal])
  @@index([tipo])
}

model AnexoEntrega {
  id             String    @id @default(cuid())
  entregaId      String
  entrega        Entrega   @relation(fields: [entregaId], references: [id], onDelete: Cascade)
  tipo           TipoAnexo @default(CANHOTO)
  objectKey      String    // chave no bucket R2
  filename       String
  mimeType       String
  size           Int       @default(0)
  descricao      String?
  uploadadoPorId String?
  uploadadoPor   User?     @relation(fields: [uploadadoPorId], references: [id])
  createdAt      DateTime  @default(now())

  @@index([entregaId])
  @@index([tipo])
}

model NotaFiscal {
  id                String    @id @default(cuid())
  chaveAcesso       String    @unique
  numero            String
  serie             String?
  emitenteCnpj      String
  emitenteRazao     String
  destinatarioCnpj  String
  destinatarioRazao String
  cidade            String?
  uf                String?
  endereco          String?
  bairro            String?
  cep               String?
  latitude          Float?
  longitude         Float?
  volumes           Int       @default(0)
  pesoBruto         Float     @default(0)
  valorNota         Float     @default(0)
  dataEmissao       DateTime?
  entregaId         String?
  xmlOriginal       String?   @db.Text

  // Cancelamento informado manualmente. A API do Meu Danfe nao responde
  // situacao de documento (provado na Fase 0), entao nao ha como descobrir
  // isto sozinho — a informacao chega do cliente e alguem registra aqui.
  cancelada       Boolean   @default(false)
  canceladaEm     DateTime?
  canceladaMotivo String?
  canceladaPorId  String?
  canceladaPor    User?     @relation("NotaCancelada", fields: [canceladaPorId], references: [id])

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  entrega           Entrega?  @relation(fields: [entregaId], references: [id], onDelete: Cascade)
  cteId             String?
  cte               CTe?      @relation(fields: [cteId], references: [id])
  avarias           Avaria[]
  avariaProdutos    AvariaProduto[] @relation("AvariaProdutoNota")
  notasServico      NotaServico[]

  @@index([emitenteCnpj])
  @@index([destinatarioCnpj])
  @@index([entregaId])
  @@index([cteId])
}

model Ocorrencia {
  id        String   @id @default(cuid())
  entregaId String
  tipo      String
  descricao String
  resolucao String?
  resolvida Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  entrega   Entrega  @relation(fields: [entregaId], references: [id], onDelete: Cascade)
}

model CTe {
  id            String       @id @default(cuid())
  chaveAcesso   String       @unique
  numero        String
  serie         String?
  dataEmissao   DateTime?
  valorReceber  Float        @default(0)
  valorPedagio  Float        @default(0)
  valorImpostos Float        @default(0)
  emitenteCnpj  String
  emitenteNome  String?
  tomadorCnpj   String
  tomadorNome   String?
  notas         NotaFiscal[]
  faturaId      String?
  fatura        Fatura?      @relation(fields: [faturaId], references: [id])
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([tomadorCnpj])
  @@index([faturaId])
}

enum StatusFatura {
  ABERTA
  PAGA
  CANCELADA
}

model Fatura {
  id              String                 @id @default(cuid())
  numero          String                 @unique
  clienteCnpj     String
  clienteNome     String
  valorFretes     Float                  @default(0)
  valorReembolsos Float                  @default(0)
  valorTotal      Float                  @default(0)
  dataEmissao     DateTime               @default(now())
  dataVencimento  DateTime
  status          StatusFatura           @default(ABERTA)
  observacoes     String?                @db.Text
  ctes            CTe[]
  entregas        Entrega[]
  lancamentos     LancamentoFinanceiro[]
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  @@index([clienteCnpj])
}

enum TipoContaPagar {
  MOTORISTA
  DESCARGA
  ABASTECIMENTO
  PEDAGIO
  OUTROS
}

enum StatusContaPagar {
  PENDENTE
  PAGO
  CANCELADO
}

model ContaPagar {
  id             String           @id @default(cuid())
  tipo           TipoContaPagar
  descricao      String
  valor          Float
  dataVencimento DateTime
  dataPagamento  DateTime?
  status         StatusContaPagar @default(PENDENTE)
  favorecido     String? // Quem vai receber (Motorista, Chapa de Descarga)
  formaPagamento FormaPagamento?
  observacoes    String?          @db.Text
  rotaId         String?
  entregaId      String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  rota        Rota?                  @relation(fields: [rotaId], references: [id], onDelete: Cascade)
  entrega     Entrega?               @relation(fields: [entregaId], references: [id], onDelete: Cascade)
  lancamentos LancamentoFinanceiro[]

  @@index([rotaId])
  @@index([entregaId])
  @@index([status])
  @@index([dataVencimento])
}

model TabelaArmazenagem {
  id             String   @id @default(cuid())
  cnpjCliente    String   @unique
  nomeCliente    String
  diasFree       Int      @default(0)
  valorPaleteDia Float    @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

enum TipoDescarga {
  POR_PALETE
  POR_AJUDANTE
  SEM_VALOR
}

model ProdutoCatalogo {
  id                String   @id @default(cuid())
  fornecedorCnpj    String
  fornecedorNome    String?
  codigo            String
  descricao         String
  descricaoNorm     String
  ncm               String?
  unidade           String?
  contagemUso       Int      @default(1)
  primeiraOcorrencia DateTime @default(now())
  ultimaOcorrencia   DateTime @default(now())

  // Último valor unitário visto e a data da NF de onde veio. Nulo = ainda não
  // indexado com preço (rodar "Reprocessar Histórico"). valorUnitarioEm existe
  // porque o backfill percorre as notas por id, não por data de emissão.
  valorUnitario     Float?
  valorUnitarioEm   DateTime?

  @@unique([fornecedorCnpj, codigo])
  @@index([descricaoNorm])
  @@index([ncm])
}

// ─── Conciliacao bancaria ────────────────────────────────────────────────
// O extrato entra por OFX do banco ou pelo export do app Minhas Financas.
// Open Finance direto e inviavel: so instituicao autorizada pelo BC participa.

model ContaBancaria {
  id      String  @id @default(cuid())
  nome    String  @unique // "Sicredi Empresas", "Banco Inter PJ"
  banco   String?
  agencia String?
  numero  String?
  ativa   Boolean @default(true)

  // Casa o <ACCTID> do cabecalho do OFX com esta conta, para o import saber
  // onde a transacao entra sem o usuario escolher a cada arquivo.
  identificadorOfx String? @unique

  transacoes  TransacaoBancaria[]
  lancamentos LancamentoFinanceiro[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TransacaoBancaria {
  id      String        @id @default(cuid())
  contaId String
  conta   ContaBancaria @relation(fields: [contaId], references: [id], onDelete: Cascade)

  data      DateTime
  valor     Float // negativo = saida
  descricao String
  documento String? // CNPJ/CPF extraido da descricao, quando houver

  // Dedupe de reimportacao. FITID quando vem de OFX; hash de
  // conta+data+valor+descricao quando vem do CSV, que nao tem identificador.
  idExterno String
  origem    String // "OFX" | "MINHAS_FINANCAS"

  status       String  @default("PENDENTE") // PENDENTE | CONCILIADA | IGNORADA
  lancamentoId String?
  lancamento   LancamentoFinanceiro? @relation(fields: [lancamentoId], references: [id], onDelete: SetNull)

  importadaEm DateTime @default(now())

  @@unique([contaId, idExterno])
  @@index([status])
  @@index([data])
  @@index([lancamentoId])
}

// ─── MDF-e (Manifesto Eletronico de Documentos Fiscais) ──────────────────
// Importado do emissor. O TMS nao emite.

enum StatusMdfe {
  AUTORIZADO
  ENCERRADO
  CANCELADO
}

model Mdfe {
  id          String @id @default(cuid())
  chaveAcesso String @unique
  numero      String
  serie       String?
  modelo      String @default("58")

  emitenteCnpj String
  emitenteNome String?

  ufInicio              String
  ufFim                 String
  municipioCarregamento String?

  dataEmissao      DateTime?
  // dhIniViagem e opcional no layout e nao vem nos manifestos da Magna Log;
  // o parser cai para dhEmi. E daqui que sai o "aberto ha N dias".
  dataInicioViagem DateTime?

  // Modal rodoviario
  placaTracao     String?
  placaReboque    String?
  rntrc           String?
  condutorNome    String?
  condutorCpf     String?
  contratanteCnpj String?

  qtdCTe     Int   @default(0)
  qtdNFe     Int   @default(0)
  valorCarga Float @default(0)
  pesoCarga  Float @default(0)

  // cStat do protocolo: 100 = autorizado
  cStat String?

  status      StatusMdfe @default(AUTORIZADO)
  encerradoEm DateTime?
  // MANUAL = alguem marcou na tela. EVENTO = veio do XML 110112.
  // A origem importa: uma e palavra, a outra e documento fiscal.
  encerradoPor       String?
  protocoloEncerramento String?

  rotaId String?
  rota   Rota?   @relation(fields: [rotaId], references: [id])

  xmlOriginal String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  documentos MdfeDocumento[]

  @@index([status])
  @@index([rotaId])
  @@index([dataInicioViagem])
}

model MdfeDocumento {
  id     String @id @default(cuid())
  mdfeId String
  mdfe   Mdfe   @relation(fields: [mdfeId], references: [id], onDelete: Cascade)

  tipo        String // "CTE" | "NFE"
  chaveAcesso String

  municipioDescarga       String?
  codigoMunicipioDescarga String?

  @@index([mdfeId])
  @@index([chaveAcesso])
}

// ─── Orçamento (a partir do Catálogo de Produtos) ────────────────────────

model Orcamento {
  id          String  @id @default(cuid())
  codigo      String  @unique // ORC-00001
  observacoes String? @db.Text
  valorTotal  Float   @default(0)

  criadoPorId String
  criadoPor   User     @relation("OrcamentoCriado", fields: [criadoPorId], references: [id])
  createdAt   DateTime @default(now())

  itens OrcamentoItem[]

  @@index([createdAt])
}

model OrcamentoItem {
  id          String    @id @default(cuid())
  orcamentoId String
  orcamento   Orcamento @relation(fields: [orcamentoId], references: [id], onDelete: Cascade)

  produtoCatalogoId String? // vínculo; não é a fonte do que foi impresso

  // Snapshot: o preço do catálogo é sobrescrito a cada NF nova do produto.
  // Sem congelar, reimprimir amanhã daria outro número.
  codigo          String
  descricao       String
  fornecedorNome  String?
  fornecedorCnpj  String
  unidade         String?
  valorUnitario   Float
  valorUnitarioEm DateTime?

  quantidade Float
  valorTotal Float

  @@index([orcamentoId])
}

model TabelaDescarga {
  id            String       @id @default(cuid())
  cnpjCliente   String       @unique
  nomeCliente   String
  tipo          TipoDescarga @default(SEM_VALOR)
  valorPalete   Float        @default(0)
  valorAjudante Float        @default(0)
  observacoes   String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

// ─── Solicitação de Aprovação de Ticket ──────────────────────────────────
// Valores e destinatários por EMBARCADOR (emitente da NF, ex: Unicharm) —
// não confundir com Entrega.cnpj, que é o destinatário da carga.

model TabelaTicket {
  id             String @id @default(cuid())
  cnpjEmbarcador String @unique
  nomeEmbarcador String

  // Cabeçalho do e-mail
  emailsPara      String? @db.Text
  emailsCopia     String? @db.Text
  assuntoModelo   String?
  textoIntro      String? @db.Text
  textoAssinatura String? @db.Text

  // Paletização
  valorPalete Float @default(0)

  // Diária por perfil de veículo (espelha o enum TipoVeiculo)
  diariaVuc         Float @default(0)
  diariaTresQuartos Float @default(0)
  diariaToco        Float @default(0)
  diariaTruck       Float @default(0)
  diariaCarreta     Float @default(0)
  diariaBitruck     Float @default(0)
  diariaUtilitario  Float @default(0)

  // Reentrega
  percentualReentrega Float @default(80)

  // Alíquotas aplicadas sobre o valor da descarga (em %)
  aliqIrpj   Float @default(8)
  aliqCsll   Float @default(12)
  aliqCofins Float @default(7.6)
  aliqPis    Float @default(1.65)
  aliqIss    Float @default(3)

  observacoes String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum TipoTicket {
  PALETIZACAO
  DESCARGA
  DIARIA
  REENTREGA
  ARMAZENAGEM
}

enum StatusSolicitacaoTicket {
  ENVIADA
  APROVADA
  RECUSADA
  CANCELADA
}

model SolicitacaoTicket {
  id        String  @id @default(cuid())
  numero    String  @unique
  entregaId String
  entrega   Entrega @relation(fields: [entregaId], references: [id], onDelete: Cascade)

  embarcadorCnpj String
  embarcadorNome String

  // Snapshot congelado das linhas comuns às tabelas do e-mail
  dataSolicitacao DateTime  @default(now())
  transportador   String    @default("MAGNA LOG")
  cliente         String
  localidade      String
  notasFiscais    String    @db.Text
  dataAgenda      DateTime?
  cteNumero       String?
  perfilVeiculo   String?
  placaVeiculo    String?
  volumes         Int       @default(0)

  destinatarios String  @db.Text
  copia         String? @db.Text
  assunto       String
  corpoHtml     String  @db.Text

  valorTotal   Float                   @default(0)
  status       StatusSolicitacaoTicket @default(ENVIADA)
  respondidaEm DateTime?
  observacoes  String?                 @db.Text

  criadoPorId String?
  criadoPor   User?   @relation("TicketCriadoPor", fields: [criadoPorId], references: [id])

  itens ItemSolicitacaoTicket[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([entregaId])
  @@index([embarcadorCnpj])
  @@index([status])
  @@index([dataSolicitacao])
}

model ItemSolicitacaoTicket {
  id            String            @id @default(cuid())
  solicitacaoId String
  solicitacao   SolicitacaoTicket @relation(fields: [solicitacaoId], references: [id], onDelete: Cascade)

  tipo        TipoTicket
  valor       Float      @default(0)
  observacoes String?

  // Memória de cálculo — só preenchida quando tipo = DESCARGA
  valorBase   Float?
  valorIrpj   Float?
  valorCsll   Float?
  valorCofins Float?
  valorPis    Float?
  valorIss    Float?

  createdAt DateTime @default(now())

  @@index([solicitacaoId])
  @@index([tipo])
}

model FaturaArmazenagem {
  id             String                  @id @default(cuid())
  numero         String                  @unique
  fornecedorCnpj String
  fornecedorNome String
  valorTotal     Float                   @default(0)
  dataEmissao    DateTime                @default(now())
  dataVencimento DateTime
  status         StatusFatura            @default(ABERTA)
  observacoes    String?                 @db.Text
  items          ItemFaturaArmazenagem[]
  lancamentos    LancamentoFinanceiro[]
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  @@index([fornecedorCnpj])
}

model ItemFaturaArmazenagem {
  id                String            @id @default(cuid())
  faturaId          String
  fatura            FaturaArmazenagem @relation(fields: [faturaId], references: [id], onDelete: Cascade)
  entregaId         String
  fornecedorCnpj    String
  codigoEntrega     String
  destinatarioRazao String?
  cidade            String?
  nfs               String?
  paletes           Int               @default(0)
  diasDecorridos    Int               @default(0)
  diasCobraveis     Int               @default(0)
  diasFree          Int               @default(0)
  valorPaleteDia    Float             @default(0)
  valorCalculado    Float             @default(0)
  dataEntrada       DateTime?
  dataSaida         DateTime?
  createdAt         DateTime          @default(now())

  @@unique([entregaId, fornecedorCnpj])
  @@index([faturaId])
  @@index([fornecedorCnpj])
}

// ─── Faturamento Transportadora (acordo por transportadora, ex: Porto Transportes) ───

model AcordoTransportadora {
  id                 String   @id @default(cuid())
  transportadoraCnpj String   @unique
  transportadoraNome String
  percentualCTE      Float    @default(20)
  taxaEntrega        Float    @default(0)
  valorPaleteFixo    Float    @default(0)
  observacoes        String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model FaturaTransportadora {
  id                 String                     @id @default(cuid())
  numero             String                     @unique
  transportadoraCnpj String
  transportadoraNome String
  dataInicio         DateTime
  dataFim            DateTime
  valorPercentualCTE Float                      @default(0)
  valorTaxaEntrega   Float                      @default(0)
  valorPaletizacao   Float                      @default(0)
  valorArmazenagem   Float                      @default(0)
  valorDiarias       Float                      @default(0)
  valorDescarga      Float                      @default(0)
  valorTotal         Float                      @default(0)
  status             StatusFatura               @default(ABERTA)
  observacoes        String?                    @db.Text
  itens              ItemFaturaTransportadora[]
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt

  @@index([transportadoraCnpj])
  @@index([dataInicio, dataFim])
}

model ItemFaturaTransportadora {
  id                 String               @id @default(cuid())
  faturaId           String
  fatura             FaturaTransportadora @relation(fields: [faturaId], references: [id], onDelete: Cascade)
  entregaId          String
  cteId              String?
  cteNumero          String?
  cteValorTotal      Float                @default(0)
  codigoEntrega      String
  destinatarioRazao  String?
  cidade             String?
  nfs                String?
  quantidadePaletes  Int                  @default(0)
  valorPercentualCTE Float                @default(0)
  valorTaxaEntrega   Float                @default(0)
  valorPaletizacao   Float                @default(0)
  valorArmazenagem   Float                @default(0)
  valorDiaria        Float                @default(0)
  valorDescarga      Float                @default(0)
  subtotal           Float                @default(0)
  createdAt          DateTime             @default(now())

  @@index([faturaId])
  @@index([entregaId])
}

model QualidadeOperacional {
  id                  String   @id @default(cuid())
  entregaId           String?  @unique
  rotaId              String?  @unique
  conferenciaCorreta  Boolean  @default(true)
  carregamentoCorreto Boolean  @default(true)
  houveAvaria         Boolean  @default(false)
  organizacaoGeral    Boolean  @default(true)
  observacoes         String?  @db.Text
  pontuacao           Int      @default(40)
  adminId             String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  entrega Entrega? @relation(fields: [entregaId], references: [id], onDelete: Cascade)
  rota    Rota?    @relation(fields: [rotaId], references: [id], onDelete: Cascade)
  admin   User     @relation("AdminQualidade", fields: [adminId], references: [id])

  @@index([entregaId])
  @@index([rotaId])
  @@index([adminId])
}

// ─── Avarias / Devoluções ────────────────────────────────────────────────

enum TipoAvaria {
  AVARIA
  FALTA
  INVERSAO
  SOBRA
  DEVOLUCAO
  SEM_PEDIDO
}

enum FaseAvaria {
  CONFERENCIA
  CARREGAMENTO
  EM_ROTA
  ENTREGA
  DEVOLUCAO
}

enum StatusAvaria {
  PENDENTE
  EM_ANALISE
  RESOLVIDA
  DESCARTADA
}

enum StatusDevolucao {
  PENDENTE
  DEVOLVIDO_CLIENTE
  RETIRADO
  DESCARTADO
}

model Avaria {
  id     String       @id @default(cuid())
  codigo String       @unique
  tipo   TipoAvaria
  fase   FaseAvaria
  status StatusAvaria @default(PENDENTE)

  entregaId    String?
  notaFiscalId String?
  motoristaId  String?
  rotaId       String?

  descricao     String  @db.Text
  observacoes   String? @db.Text
  valorPrejuizo Float   @default(0)

  registradoPorId String
  dataOcorrencia  DateTime
  localOcorrencia String?

  dataChegada           DateTime?
  transportadoraChegada String?
  motoristaChegada      String?
  motoristaCpfChegada   String?
  placaChegada          String?

  resolucao      String?   @db.Text
  resolvidoPorId String?
  dataResolucao  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entrega       Entrega?    @relation(fields: [entregaId], references: [id])
  notaFiscal    NotaFiscal? @relation(fields: [notaFiscalId], references: [id])
  motorista     Motorista?  @relation(fields: [motoristaId], references: [id])
  rota          Rota?       @relation(fields: [rotaId], references: [id])
  registradoPor User        @relation("AvariaRegistrada", fields: [registradoPorId], references: [id])
  resolvidoPor  User?       @relation("AvariaResolvida", fields: [resolvidoPorId], references: [id])

  produtos   AvariaProduto[]
  devolucoes NotaDevolucao[]

  @@index([entregaId])
  @@index([notaFiscalId])
  @@index([motoristaId])
  @@index([status])
  @@index([tipo])
  @@index([dataOcorrencia])
}

model AvariaProduto {
  id               String   @id @default(cuid())
  avariaId         String
  codigoProduto    String
  descricao        String
  ncm              String?
  unidade          String?
  quantidadeNF     Float
  quantidadeAvaria Float
  valorUnitario    Float    @default(0)
  valorTotal       Float    @default(0)
  observacoes      String?  @db.Text
  createdAt        DateTime @default(now())

  // Declaração de Recebimento — tipo por linha (declaração pode misturar Falta/Sobra/Avaria/etc)
  tipoDivergencia TipoAvaria?
  notaFiscalId    String?

  avaria     Avaria      @relation(fields: [avariaId], references: [id], onDelete: Cascade)
  notaFiscal NotaFiscal? @relation("AvariaProdutoNota", fields: [notaFiscalId], references: [id])

  @@index([avariaId])
  @@index([notaFiscalId])
}

// ─── Controle de Paletes CHEP ────────────────────────────────────────────

enum TipoMovimentoPalete {
  SAIDA
  ENTRADA
}

enum StatusPalete {
  PENDENTE
  ACEITO
  CANCELADO
  RETORNOU
}

model PaleteConfig {
  id         String   @id @default("default")
  cnpjPool   String   @default("")
  razaoPool  String   @default("")
  glnPool    String   @default("")
  tipoPallet String   @default("CHEP")
  updatedAt  DateTime @updatedAt
}

model PaleteMovimento {
  id             String              @id @default(cuid())
  nf             String
  tipoPallet     String              @default("CHEP")
  dataEmissao    DateTime
  quantidade     Int
  cnpjCliente    String
  razaoCliente   String
  glnCliente     String?
  tipoMovimento  TipoMovimentoPalete
  status         StatusPalete        @default(PENDENTE)
  observacoes    String?
  ticketBaixa    String?
  chaveAcessoNFe String?             @unique
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([dataEmissao])
  @@index([status])
  @@index([tipoMovimento])
  @@index([cnpjCliente])
}

model NotaDevolucao {
  id                String    @id @default(cuid())
  avariaId          String
  chaveAcesso       String    @unique
  numero            String
  serie             String?
  emitenteCnpj      String
  emitenteRazao     String
  destinatarioCnpj  String
  destinatarioRazao String
  dataEmissao       DateTime?
  valorNota         Float     @default(0)
  xmlOriginal       String?   @db.Text

  status       StatusDevolucao @default(PENDENTE)
  dataRetorno  DateTime?
  dataRetirada DateTime?
  dataDescarte DateTime?
  responsavel  String?
  observacoes  String?         @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  avaria Avaria @relation(fields: [avariaId], references: [id], onDelete: Cascade)

  @@index([avariaId])
  @@index([status])
}

// ─── Declaração de Saída ─────────────────────────────────────────────────
// Documento de retirada: agrega avarias, notas de devolução e ocorrências
// numa seleção única, e é impresso para o motorista assinar.

enum OrigemSaidaItem {
  AVARIA
  DEVOLUCAO
  OCORRENCIA
}

model DeclaracaoSaida {
  id     String @id @default(cuid())
  codigo String @unique // DS-00001

  // Quem está retirando a mercadoria
  transportadora String
  motoristaNome  String
  motoristaCpf   String?
  placa          String

  observacoes String? @db.Text
  valorTotal  Float   @default(0) // snapshot do total impresso

  emitidoPorId String
  emitidoPor   User     @relation("DeclaracaoSaidaEmitida", fields: [emitidoPorId], references: [id])
  createdAt    DateTime @default(now())

  itens DeclaracaoSaidaItem[]

  @@index([createdAt])
}

model DeclaracaoSaidaItem {
  id           String          @id @default(cuid())
  declaracaoId String
  declaracao   DeclaracaoSaida @relation(fields: [declaracaoId], references: [id], onDelete: Cascade)

  origem          OrigemSaidaItem
  avariaId        String?
  notaDevolucaoId String?
  ocorrenciaId    String?

  // Snapshot do que foi impresso — o documento é assinado, então não pode
  // mudar se a avaria de origem for editada depois. Os ids acima ficam só
  // para navegação e rastreio.
  referencia String // "AVR-00025" | "NF 12345" | "ENT-00088"
  descricao  String
  quantidade Float?
  valor      Float  @default(0)

  @@index([declaracaoId])
  @@index([avariaId])
  @@index([notaDevolucaoId])
}

// ─── ERP Financeiro ──────────────────────────────────────────────────────

enum TipoLancamento {
  RECEITA
  DESPESA
}

enum StatusLancamento {
  PENDENTE
  PAGO
  CANCELADO
}

enum FormaPagamento {
  DINHEIRO
  PIX
  TRANSFERENCIA
  BOLETO
  CARTAO_CREDITO
  CARTAO_DEBITO
  CHEQUE
  OUTRO
}

enum OrigemLancamento {
  MANUAL
  EXTRATO_BANCARIO
  FATURA
  FATURA_ARMAZENAGEM
  ACERTO_MOTORISTA
  CONTA_PAGAR
  NOTA_SERVICO
  DIARIA
}

enum StatusDiaria {
  PENDENTE
  PAGA
  CANCELADA
}

model Diaria {
  id             String       @id @default(cuid())
  numero         String       @unique
  entregaId      String
  entrega        Entrega      @relation(fields: [entregaId], references: [id], onDelete: Cascade)

  clienteCnpj    String
  clienteNome    String

  motivo         String?
  valor          Float        @default(0)
  status         StatusDiaria @default(PENDENTE)

  dataOcorrencia DateTime     @default(now())
  dataPagamento  DateTime?
  formaPagamento FormaPagamento?
  observacoes    String?      @db.Text

  lancamentos    LancamentoFinanceiro[]

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([entregaId])
  @@index([clienteCnpj])
  @@index([status])
}

model NotaServico {
  id                 String   @id @default(cuid())
  numero             String
  codigoVerificacao  String?
  dataEmissao        DateTime
  valorServicos      Float    @default(0)
  valorIss           Float    @default(0)
  aliquota           Float    @default(0)

  prestadorCnpj      String
  prestadorRazao     String?
  tomadorCnpj        String
  tomadorRazao       String?
  tomadorMunicipio   String?
  tomadorUf          String?

  discriminacao      String?  @db.Text
  informacoesAdicionais String? @db.Text

  entregaId          String?
  entrega            Entrega? @relation(fields: [entregaId], references: [id], onDelete: SetNull)
  notaFiscalId       String?
  notaFiscal         NotaFiscal? @relation(fields: [notaFiscalId], references: [id], onDelete: SetNull)

  lancamentos        LancamentoFinanceiro[]

  xmlOriginal        String?  @db.Text
  arquivoNome        String?

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([prestadorCnpj, numero])
  @@index([tomadorCnpj])
  @@index([entregaId])
  @@index([notaFiscalId])
  @@index([dataEmissao])
}

model CategoriaFinanceira {
  id            String                   @id @default(cuid())
  nome          String
  tipo          TipoLancamento
  ativo         Boolean                  @default(true)
  ordem         Int                      @default(0)
  sistema       Boolean                  @default(false) // categoria padrão (não pode apagar, só desativar)
  subcategorias SubcategoriaFinanceira[]
  lancamentos   LancamentoFinanceiro[]
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt

  @@unique([nome, tipo])
  @@index([tipo, ativo])
}

model SubcategoriaFinanceira {
  id          String                 @id @default(cuid())
  nome        String
  ativo       Boolean                @default(true)
  categoriaId String
  categoria   CategoriaFinanceira    @relation(fields: [categoriaId], references: [id], onDelete: Cascade)
  lancamentos LancamentoFinanceiro[]
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  @@unique([categoriaId, nome])
  @@index([categoriaId])
}

model LancamentoFinanceiro {
  id             String           @id @default(cuid())
  descricao      String
  tipo           TipoLancamento
  valor          Float
  dataVencimento DateTime
  dataPagamento  DateTime?
  status         StatusLancamento @default(PENDENTE)
  origem         OrigemLancamento @default(MANUAL)

  formaPagamento FormaPagamento?
  contaBancaria  String? // legado: texto livre, nunca preenchido. Use contaBancariaRel.

  contaBancariaId  String?
  contaBancariaRel ContaBancaria? @relation(fields: [contaBancariaId], references: [id], onDelete: SetNull)
  transacoes       TransacaoBancaria[]

  // Equivalente ao "Ignorar nos totais" do Minhas Financas: segue no caixa,
  // sai do DRE. Necessario porque o extrato traz despesa pessoal e tarifa
  // bancaria junto com o operacional.
  foraDoDre Boolean @default(false)

  categoriaId    String?
  subcategoriaId String?
  categoria      CategoriaFinanceira?    @relation(fields: [categoriaId], references: [id], onDelete: SetNull)
  subcategoria   SubcategoriaFinanceira? @relation(fields: [subcategoriaId], references: [id], onDelete: SetNull)

  favorecido  String?
  anexoUrl    String?
  observacoes String? @db.Text

  rotaId              String?
  entregaId           String?
  faturaId            String?
  faturaArmazenagemId String?
  contaPagarId        String?
  notaServicoId       String?
  diariaId            String?

  rota              Rota?              @relation(fields: [rotaId], references: [id], onDelete: SetNull)
  entrega           Entrega?           @relation(fields: [entregaId], references: [id], onDelete: SetNull)
  fatura            Fatura?            @relation(fields: [faturaId], references: [id], onDelete: SetNull)
  faturaArmazenagem FaturaArmazenagem? @relation(fields: [faturaArmazenagemId], references: [id], onDelete: SetNull)
  contaPagar        ContaPagar?        @relation(fields: [contaPagarId], references: [id], onDelete: SetNull)
  notaServico       NotaServico?       @relation(fields: [notaServicoId], references: [id], onDelete: SetNull)
  diaria            Diaria?            @relation(fields: [diariaId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoriaId])
  @@index([subcategoriaId])
  @@index([rotaId])
  @@index([entregaId])
  @@index([faturaId])
  @@index([faturaArmazenagemId])
  @@index([contaPagarId])
  @@index([notaServicoId])
  @@index([diariaId])
  @@index([status, dataPagamento])
  @@index([tipo, dataPagamento])
  @@index([contaBancariaId])
}

model NormaPaletizacao {
  id                     String   @id @default(cuid())
  clienteCnpj            String // CNPJ do Cliente (Destinatário que recebe a mercadoria)
  fornecedorCnpj         String // CNPJ do Fornecedor (Emitente da NF)
  codigoProduto          String // Código do produto (CODPROD) do XML da NF
  descricao              String? // Descrição do produto para conferência
  embalagem              String? // Ex: "8X1"
  lastro                 Int // Quantidade de caixas na camada (lastro)
  altura                 Int // Quantidade de camadas de altura
  quantidadeCaixasPalete Int // Quantidade de caixas total por palete (lastro * altura)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@unique([clienteCnpj, fornecedorCnpj, codigoProduto])
  @@index([clienteCnpj])
  @@index([fornecedorCnpj])
}

// ---------------------------------------------------------------------------
// WhatsApp (Pingo Notify)
// ---------------------------------------------------------------------------

// Configuração única do envio de WhatsApp. As credenciais NÃO ficam aqui —
// vivem em PINGO_API_KEY / PINGO_CONNECTION_ID nas env vars.
model WhatsAppConfig {
  id            String   @id @default("default")
  ativo         Boolean  @default(false) // desligado até a conexão ser testada
  cotaMensal    Int      @default(100) // teto do plano gratuito
  limiteReserva Int      @default(90) // trava aqui; o resto é reserva de ADMIN
  maxCaracteres Int      @default(600) // limite de texto do plano gratuito
  updatedAt     DateTime @updatedAt
}

enum StatusMensagemWhats {
  ENVIADA
  FALHOU
}

// Log de mensagens enviadas. É este log que serve de contador da cota mensal:
// só as ENVIADA de uma competência contam. Os campos são snapshot congelado —
// editar cliente ou entrega depois não altera o histórico.
model MensagemWhats {
  id           String              @id @default(cuid())
  entregaId    String?
  telefone     String // E.164 normalizado, ex "5511999998888"
  destinatario String // nome do cliente no momento do envio
  texto        String              @db.Text
  status       StatusMensagemWhats @default(ENVIADA)
  erro         String?             @db.Text
  providerId   String? // id da mensagem devolvido pelo Pingo
  competencia  String // "2026-09", calculado em America/Sao_Paulo
  enviadoPorId String?
  createdAt    DateTime            @default(now())

  entrega    Entrega? @relation(fields: [entregaId], references: [id], onDelete: SetNull)
  enviadoPor User?    @relation("MensagemWhatsEnviadaPor", fields: [enviadoPorId], references: [id], onDelete: SetNull)

  @@index([competencia])
  @@index([entregaId])
  @@index([createdAt(sort: Desc)])
}
